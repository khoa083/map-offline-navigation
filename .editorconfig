root = true

[*.{kt,kts}]
# Compose convention: @Composable functions that emit UI are PascalCase. Without this,
# ktlint's function-naming rule flags every composable in the app.
# https://pinterest.github.io/ktlint/latest/rules/standard/#function-naming
ktlint_function_naming_ignore_when_annotated_with = Composable
