<?xml version="1.0" encoding="utf-8"?>
<!-- Maneuver glyph, ported 1:1 (pathData copied verbatim) from the design spec's "4e Maneuver
     icon set" - the 16-glyph GraphHopper maneuver family ("Sixteen maneuvers, sixteen drawings,
     never one arrow rotated by heading"). Deliberately colorless: fillColor/strokeColor below are
     neutral placeholders only, NEVER the real displayed color.
     ALWAYS render this via Icon(painter = painterResource(...), tint = ...) from ManeuverIcon.kt
     - never Image(), and never a hardcoded Color.White/Color.Black at the call site. That
     hardcoded-tint pattern is the exact bug (icon looks black/white/teal at random depending on
     which screen + theme it's on) this asset set and ManeuverIcon.kt replace.
     Enter roundabout / Leave roundabout complete this set - see the header of
     ic_maneuver_use_roundabout.xml for their construction rules. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="32"
    android:viewportHeight="32">
    <path
        android:pathData="M11 28.5V4M11 5H23L20 10L23 15H11"
        android:strokeColor="#FF1B1B1B"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
